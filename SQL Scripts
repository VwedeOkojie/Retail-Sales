--Yearly KPI per Store
WITH yearly_sales AS(
SELECT 
	store_id,
	DATE_TRUNC('year',date) AS yearly,
	ROUND(SUM(sales)) AS sales,
	ROUND(SUM(transactions)::NUMERIC/ NULLIF(SUM(traffic_count),0)*100,2) AS conversion_rate,
	ROUND(SUM(sales)::NUMERIC/ NULLIF(SUM(transactions), 0), 2) AS avg_transaction_value,
	ROUND(SUM(units_sold)::NUMERIC/ NULLIF(SUM(transactions),0), 2) AS unit_per_transaction,
	ROUND(SUM(sales)::NUMERIC/ NULLIF(SUM(staff_hours),0)::NUMERIC,2) AS productivity,
	ROUND(SUM(sales)::NUMERIC/ NULLIF(SUM(sales_goal),0)::NUMERIC *100,2) AS actual_vs_goal,
	ROUND(SUM(crm_signups)::NUMERIC/ NULLIF(SUM(transactions),0)*100,2) AS crm_rate
FROM retail_sales
GROUP BY store_id,DATE_TRUNC('year',date)
)
SELECT 
  store_id,
  yearly,
  EXTRACT(YEAR FROM yearly)::INT AS year_number,
  sales,
  conversion_rate,
  avg_transaction_value,
  unit_per_transaction,
  productivity,
  actual_vs_goal,
  crm_rate
FROM yearly_sales
ORDER BY store_id, yearly;
